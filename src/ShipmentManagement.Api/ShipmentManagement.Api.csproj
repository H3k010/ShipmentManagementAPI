<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f0d7361f-d211-46d0-b531-c0de25e3e795</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc"/>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer"/>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Settings.Configuration"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Sinks.MySQL"/>
    <PackageReference Include="Swashbuckle.AspNetCore"/>
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DocumentationFile>$(MSBuildProjectDirectory)/OpenApi/ShipmentManagement.Api.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="OpenApi/ShipmentManagement.Api.xml"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('OpenApi/ShipmentManagement.Api.xml')"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShipmentManagement.Infrastructure\ShipmentManagement.Infrastructure.csproj"/>
  </ItemGroup>

</Project>
